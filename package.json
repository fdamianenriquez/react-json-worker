{
  "name": "react-json-worker",
  "version": "0.1.0",
  "description": "Offload large-scale JSON processing to a Web Worker, keeping the UI thread responsive.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "generate-json": "node demo/generate-json.mjs",
    "predev": "node demo/generate-json.mjs",
    "dev": "vite",
    "prebuild": "node demo/generate-json.mjs",
    "build:lib": "tsc",
    "build": "npm run build:lib && vite build",
    "test": "vitest run",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  },
  "license": "MIT"
}
