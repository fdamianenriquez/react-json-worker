{
  "name": "react-json-worker",
  "version": "0.2.0",
  "description": "Offload large-scale JSON processing to a Web Worker, keeping the UI thread responsive.",
  "keywords": [
    "react",
    "hook",
    "web-worker",
    "worker",
    "json",
    "performance",
    "off-main-thread",
    "usejsonworker"
  ],
  "author": "Damian Enriquez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdamianenriquez/react-json-worker.git"
  },
  "homepage": "https://github.com/fdamianenriquez/react-json-worker#readme",
  "bugs": {
    "url": "https://github.com/fdamianenriquez/react-json-worker/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate-json": "node demo/generate-json.mjs",
    "predev": "node demo/generate-json.mjs",
    "dev": "vite",
    "prebuild": "node demo/generate-json.mjs",
    "build:lib": "tsc",
    "build": "npm run build:lib && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "check:package": "publint --pack npm && attw --pack . --profile esm-only",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
